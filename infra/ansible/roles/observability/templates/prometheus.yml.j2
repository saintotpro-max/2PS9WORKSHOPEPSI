# {{ ansible_managed }}
global:
  scrape_interval: 15s
  # Évaluation rapide des règles : la détection d'une panne conditionne la durée de reprise
  evaluation_interval: 5s

alerting:
  alertmanagers:
    - static_configs:
        - targets: [alertmanager:9093]

rule_files:
  - /etc/prometheus/rules/*.yml

scrape_configs:
  - job_name: prometheus
    static_configs:
      - targets: [localhost:9090]

  - job_name: node
    static_configs:
      - targets: ["{{ docker_lan_ip }}:9100"]
        labels: {host: ra-docker}
      - targets: ["{{ ips_admin_ip }}:9100"]
        labels: {host: ra-ips}

  - job_name: cadvisor
    static_configs:
      - targets: [cadvisor:8080]
        labels: {host: ra-docker}

  # Sonde IPS : relevé rapproché pour suivre une attaque en direct
  - job_name: ips
    scrape_interval: 5s
    static_configs:
      - targets: ["{{ ips_admin_ip }}:9101"]
        labels: {host: ra-ips}

  - job_name: obs-stack
    static_configs:
      - targets: [alertmanager:9093, grafana:3000, loki:3100, alloy:12345]

  - job_name: remediation
    static_configs:
      - targets: [remediation:8000]
        labels: {host: ra-docker}

  - job_name: paiement
    static_configs:
      - targets: [paiement:8000]
        labels: {host: ra-docker}

  - job_name: txn-probe
    scrape_interval: 5s
    static_configs:
      - targets: [txn-probe:9102]
        labels: {host: ra-docker}

  - job_name: postgres
    static_configs:
      - targets: [postgres-exporter:9187]
        labels: {host: ra-docker}

  # Sondes HTTP de disponibilité (la sonde transactionnelle métier s'ajoutera ici)
  - job_name: blackbox-http
    scrape_interval: 5s
    metrics_path: /probe
    params:
      module: [http_2xx]
    static_configs:
      - targets:
          - http://grafana:3000/api/health
          - http://waf:8080/healthz
    relabel_configs:
      - source_labels: [__address__]
        target_label: __param_target
      - source_labels: [__param_target]
        target_label: instance
      - target_label: __address__
        replacement: blackbox-exporter:9115
{% if platform_app_services | length > 0 %}

  # /health des services applicatifs, sondé depuis le réseau front (blackbox-front)
  - job_name: blackbox-services
    scrape_interval: 5s
    metrics_path: /probe
    params:
      module: [http_2xx]
    static_configs:
{% for s in platform_app_services %}
      - targets: ["{{ s.health_url }}"]
        labels: {service: {{ s.name }}}
{% endfor %}
    relabel_configs:
      - source_labels: [__address__]
        target_label: __param_target
      - source_labels: [__param_target]
        target_label: instance
      - target_label: __address__
        replacement: blackbox-front:9115
{% endif %}
