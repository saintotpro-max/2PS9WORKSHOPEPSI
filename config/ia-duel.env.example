# Duel IA (attaquant vs defenseur) -- modele reel via API OpenAI-compatible.
#
# COPIER ce fichier HORS DEPOT puis y coller votre cle et votre modele :
#   mkdir -p ~/.config/alpha
#   cp config/ia-duel.env.example ~/.config/alpha/ia-duel.env
#   # puis editer ~/.config/alpha/ia-duel.env (jamais commite ; aucun secret dans le depot)
#
# Active le duel en mode reel. Hors demo seulement : le jour J, repli deterministe.
IA_DUEL=1

# Endpoint OpenAI-compatible (/chat/completions ajoute par le connecteur).
#   NanoGPT    : https://nano-gpt.com/api/v1
#   OpenRouter : https://openrouter.ai/api/v1
IA_URL=https://openrouter.ai/api/v1

# Votre cle API (a COLLER ici, hors depot).
IA_API_KEY=colle-ta-cle-ici

# Modele (nom exact chez le fournisseur). Exemples :
#   OpenRouter : qwen/qwen-2.5-72b-instruct  |  anthropic/claude-3.5-sonnet
#   NanoGPT    : qwen/qwen3.8-27b-cybersecurity
IA_MODEL=qwen/qwen-2.5-72b-instruct

# Optionnel : modeles distincts par persona (sinon IA_MODEL pour les deux).
# IA_MODEL_ATTAQUE=...
# IA_MODEL_DEFENSE=...
